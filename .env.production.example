# Production environment. Copy to .env.production and fill every value in.
#
# There are no defaults here on purpose. A missing value stops the compose
# command rather than starting the stack with a blank or a guessable one, and
# the control plane refuses to start in production if the development keys from
# .env.example are still in place.
#
# This file is gitignored. Do not commit the filled-in copy.

# ---------------------------------------------------------------------------
# Public addresses
#
# Both are the hostnames you map in the Cloudflare tunnel. They must be the
# exact origins the browser sees, including https, because CORS compares them
# character for character and the API allows exactly one.
#
# VANTAGE_PUBLIC_API_ORIGIN is baked into the browser bundle at BUILD time, so
# changing it later means rebuilding the web image rather than restarting it.
VANTAGE_PUBLIC_WEB_ORIGIN=https://vantage.example.com
VANTAGE_PUBLIC_API_ORIGIN=https://vantage-api.example.com

# ---------------------------------------------------------------------------
# Database passwords
#
# Four roles with different privileges. The app role cannot alter the schema,
# the research role is read only, and only the owner runs migrations. Generate
# each separately:
#
#   openssl rand -base64 24
#
# VANTAGE_POSTGRES_RESEARCH_PASSWORD creates the read-only vantage_research
# role and is not handed to any container. No service uses it; it is there for
# an analyst connecting to the database directly. Generate it anyway, because
# the role is created either way and an unset password is a blank one.
POSTGRES_SUPERUSER_PASSWORD=
VANTAGE_POSTGRES_OWNER_PASSWORD=
VANTAGE_POSTGRES_APP_PASSWORD=
VANTAGE_POSTGRES_RESEARCH_PASSWORD=

# The two connection strings, passed whole rather than assembled by compose.
#
# Shape: postgres://u:p@postgres:5432/vantage?sslmode=disable
#
# The host is `postgres`, the container name on the compose network, not
# localhost. The role names are vantage_app and vantage_owner, each taking the
# matching password from above.
#
# Rather than substituting by hand, DEPLOYMENT.md gives a command that writes
# both lines for you from the passwords you generated.
VANTAGE_DATABASE_URL=
VANTAGE_MIGRATION_DATABASE_URL=

# ---------------------------------------------------------------------------
# Application keys
#
# Generate each with:
#
#   openssl rand -base64 32
#
# VANTAGE_DATA_ENCRYPTION_KEY encrypts secrets at rest, today the TOTP secrets.
# Losing it means losing the ability to decrypt them; rotate by adding a new
# version rather than replacing this one, so old ciphertext stays readable.
VANTAGE_DATA_ENCRYPTION_KEY=
VANTAGE_DATA_ENCRYPTION_KEY_VERSION=1

# Signs session cookies. Changing it signs every live session out.
VANTAGE_SESSION_SIGNING_KEY=

# Authenticates the control plane to the research service. The research service
# refuses an unauthenticated call.
VANTAGE_QUANT_SERVICE_TOKEN=

# ---------------------------------------------------------------------------
# Cloudflare tunnel
#
# From the Cloudflare dashboard: Zero Trust, Networks, Tunnels, create a
# tunnel, then copy the token it shows. The token IS a credential: anyone
# holding it can publish traffic as this tunnel.
CLOUDFLARE_TUNNEL_TOKEN=

# ---------------------------------------------------------------------------
# Optional
#
# Historical market data. Leave empty and the platform runs on its mock
# provider; every other market-data path is unaffected and the terminal says
# the provider is unconfigured rather than pretending otherwise.
TWELVE_DATA_API_KEY=

# Backups. Daily, keeping two weeks, by default.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP=14

# Off site. Leave both empty and backups stay on this machine.
#
# Set both together. A recipient with no remote encrypts files that go nowhere,
# and a remote with no recipient would ship the audit chain, the ledger and the
# password hashes in the clear.
#
# The PRIVATE half of this key must never live on this server. That is the whole
# point: compromising the machine then yields the live database, which it was
# always going to, and not one archived backup. See DEPLOYMENT.md.
BACKUP_AGE_RECIPIENT=
BACKUP_RCLONE_REMOTE=
BACKUP_RCLONE_CONFIG=

VANTAGE_LOG_LEVEL=info
VANTAGE_QUANT_TIMEOUT_SECONDS=15
