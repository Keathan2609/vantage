# Line endings are normalised to LF in the repository.
#
# This is not a style preference. A shell script or a Dockerfile checked out
# with CRLF fails at runtime with an error that names the wrong thing
# ("/bin/sh^M: bad interpreter"), and the container that fails is usually the
# one nobody is watching.
* text=auto eol=lf

# Windows-only files keep CRLF, because PowerShell and cmd are the things
# reading them.
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary, so Git never tries to translate anything inside them.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.parquet binary
*.joblib binary
*.pkl binary
*.onnx binary

# Generated: collapse it in diffs and exclude it from language statistics,
# but still review it when a dependency changes.
apps/web/package-lock.json linguist-generated=true
services/control-api/go.sum linguist-generated=true
