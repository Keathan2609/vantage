# Vantage local development configuration.
# Copy to .env and adjust. NEVER commit .env.
#
# Every value here is DEVELOPMENT ONLY. No real broker credentials belong in
# this file, in this repository, or in any environment this build can reach.

# ---------------------------------------------------------------------------
# Execution safety
# ---------------------------------------------------------------------------
# The only value this build accepts is "paper". The control plane refuses to
# start on any other value, and no live broker adapter is compiled in.
VANTAGE_EXECUTION_MODE=paper

# Comma-separated broker adapters permitted at runtime. Only "mock" exists.
VANTAGE_ENABLED_BROKERS=mock

# ---------------------------------------------------------------------------
# Control plane (Go)
# ---------------------------------------------------------------------------
VANTAGE_ENV=development
VANTAGE_HTTP_ADDR=:8080
VANTAGE_LOG_LEVEL=info
VANTAGE_PUBLIC_WEB_ORIGIN=http://localhost:3000

# Postgres. The application role is NOT a superuser.
VANTAGE_DATABASE_URL=postgres://vantage_app:vantage_app_dev_password@localhost:5432/vantage?sslmode=disable

# Migrations run as the OWNER role, not the application role.
#
# This is separate on purpose: vantage_app has DML only, and
# infra/docker/postgres-init/00-roles.sql deliberately withholds CREATE from
# it, so a compromised control plane cannot alter the schema. Migrations
# therefore need the owner.
#
# Omitting this is not a harmless default. `migrate` falls back to
# VANTAGE_DATABASE_URL and fails with "permission denied for schema public",
# which is what `./scripts/dev-up.ps1 -Reset -Seed` did on a fresh volume until
# this line was added.
VANTAGE_MIGRATION_DATABASE_URL=postgres://vantage_owner:vantage_owner_dev_password@localhost:5432/vantage?sslmode=disable

# Redis is used only for rate-limit state and bounded caching. It is never the
# source of truth for financial state; the platform degrades safely without it.
VANTAGE_REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Cryptography
# ---------------------------------------------------------------------------
# 32-byte key, base64-encoded, used to encrypt MFA secrets and (in future)
# broker credentials at rest. Generate a fresh one per environment:
#   openssl rand -base64 32
# In production this is expected to come from a KMS, not an env file.
VANTAGE_DATA_ENCRYPTION_KEY=ZGV2ZWxvcG1lbnQtb25seS1rZXktMzJieXRlcyEhISE=
VANTAGE_DATA_ENCRYPTION_KEY_VERSION=1

# Signing key for session cookies and CSRF tokens (base64, 32 bytes).
VANTAGE_SESSION_SIGNING_KEY=ZGV2ZWxvcG1lbnQtb25seS1zZXNzaW9uLWtleS0zMmI=

# ---------------------------------------------------------------------------
# Quant / research service (Python)
# ---------------------------------------------------------------------------
VANTAGE_QUANT_BASE_URL=http://localhost:8000
# Shared secret the control plane presents to the quant service. The quant
# service has no credentials pointing back at the control plane: research code
# has no network path to order execution.
VANTAGE_QUANT_SERVICE_TOKEN=development-only-quant-service-token
VANTAGE_QUANT_TIMEOUT_SECONDS=15

# Quant service's own configuration
VANTAGE_QUANT_HTTP_ADDR=0.0.0.0:8000
VANTAGE_QUANT_READONLY_DATABASE_URL=postgres://vantage_research:vantage_research_dev_password@localhost:5432/vantage?sslmode=disable
VANTAGE_QUANT_ARTIFACT_DIR=./data/artifacts

# ---------------------------------------------------------------------------
# Frontend (Next.js)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_VANTAGE_API_BASE_URL=http://localhost:8080

# --- Market-data provider (Twelve Data) --------------------------------------
#
# OPTIONAL. Without it the platform starts normally, the provider reports
# MISCONFIGURED, and synthetic data, replay and everything already stored keep
# working. Historical acquisition is the only thing unavailable.
#
# SERVER-SIDE ONLY. This is never sent to the browser, never returned by an
# API, never logged and never placed in a decision snapshot. The browser talks
# to Vantage; Vantage talks to the provider.
TWELVE_DATA_API_KEY=

# The provider origin. FIXED configuration, never a request parameter: a URL a
# caller could steer is an SSRF primitive pointed at whatever the server can
# reach. Must be an https origin with no path or query.
VANTAGE_TWELVE_DATA_BASE_URL=https://api.twelvedata.com

# Outbound request ceiling per minute. Deliberately under the free plan's 8,
# because being throttled by a provider reads downstream as an outage.
VANTAGE_TWELVE_DATA_RPM=7

# Where research dataset snapshots are materialised for the Python research
# plane, which does not touch the control plane's database.
VANTAGE_RESEARCH_DATA_DIR=../quant/research-data
